from pathlib import Path
import os,subprocess,json,time,fcntl,shutil,concurrent.futures
import pandas as pd
BASE=Path('${PROJECT_ARCHIVE_ROOT}');R=BASE/'spatial_CoVarNet_R4_20261115_v1';S=BASE/'w2o_annotation_r4_covarnet_k15_20261115_v1'
lock=(R/'controller.lock').open('w');fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
envroot=Path('${ENV_ROOT}')
env=os.environ.copy();env.update(OPENBLAS_NUM_THREADS='4',OMP_NUM_THREADS='4',MPLCONFIGDIR=str(R/'mpl_cache'),PYTHONUNBUFFERED='1')
def run(name,cmd):
    (R/'STATUS.json').write_text(json.dumps({'stage':name,'state':'running','utc_epoch':time.time()}))
    with (R/'logs'/f'{name}.log').open('w') as f:p=subprocess.run(cmd,stdout=f,stderr=subprocess.STDOUT,env=env)
    if p.returncode:raise RuntimeError(f'{name} exit {p.returncode}')
try:
    deadline=time.time()+3600
    while not (R/'reference/preparation.json').exists():
        if time.time()>deadline:raise TimeoutError('reference preparation timeout')
        time.sleep(15)
    for d in ['adapter/CM_results','adapter/inputs','author','audit']:(R/d).mkdir(parents=True,exist_ok=True)
    edges=pd.read_csv(S/'covarnet/export/module_edges.tsv',sep='\t');W=pd.read_csv(S/'covarnet/paper/cm_node_weights.tsv',sep='\t',index_col=0);mapping=pd.read_csv(S/'covarnet/node_mapping.tsv',sep='\t').set_index('node')
    rows=[]
    for cm,e in edges.groupby('cm'):
        for n in sorted(set(e.subCluster1)|set(e.subCluster2)):rows.append({'cm':cm,'subCluster':n,'weight':float(W.loc[n,cm]),'majorCluster':mapping.loc[n,'majorCluster']})
    mem=pd.DataFrame(rows);mem.to_csv(R/'adapter/CM_results/CM_members_after_author_network_filter.tsv',sep='\t',index=False);mem.to_csv(R/'adapter/CM_results/each_node.tsv',sep='\t',index=False);edges.to_csv(R/'adapter/CM_results/each_edge.tsv',sep='\t',index=False);W.to_csv(R/'adapter/CM_results/W_PRIVATE.tsv',sep='\t');mapping.to_csv(R/'adapter/inputs/frequency_PRIVATE.tsv',sep='\t')
    shutil.copy2(S/'provenance/code/frozen_author_CoVarNet_v1.R',R/'author/CoVarNet.R')
    py=str(envroot/'scvi/bin/python');scan=str(envroot/'scanpy/bin/python');rs=str(envroot/'scrna_r/bin/Rscript')
    run('reference_fit',[py,str(R/'code/fit.py'),str(R),'reference'])
    def section(key):
        run(key+'_fit',[py,str(R/'code/fit.py'),str(R),'section',key])
        run(key+'_score',[rs,'--vanilla',str(R/'code/score.R'),str(R),str(R/'adapter'),key])
        run(key+'_audit',[scan,str(R/'code/score_audit.py'),str(R),str(R/'adapter'),key])
    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
        list(pool.map(section,['S001','S002','S037','S038']))
    (R/'STATUS.json').write_text(json.dumps({'stage':'visium_complete','state':'complete','sections':4,'utc_epoch':time.time()}))
except Exception as e:
    (R/'STATUS.json').write_text(json.dumps({'state':'failed','error':str(e),'utc_epoch':time.time()}));raise
