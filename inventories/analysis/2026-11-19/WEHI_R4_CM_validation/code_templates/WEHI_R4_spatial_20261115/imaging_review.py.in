from pathlib import Path
import pandas as pd,json,shutil,tarfile,hashlib
R=Path('${PROJECT_ARCHIVE_ROOT}/spatial_CoVarNet_R4_20261115_v1');O=R/'imaging_completed_review';O.mkdir(exist_ok=True);(O/'figures').mkdir(exist_ok=True)
assert json.loads((R/'imaging/independent_audit.json').read_text())['status'].startswith('PASS_')
def table(x):return x.to_html(index=False,float_format=lambda x:f'{x:.3g}',border=0)
e=pd.read_csv(R/'imaging/core_marker_spatial_edges.tsv',sep='\t');q=pd.read_csv(R/'imaging/activity_qualification.tsv',sep='\t');c=pd.read_csv(R/'cosmx_broad/sample_core_edge_summary.tsv',sep='\t')
parts=['''<!doctype html><html lang="zh"><meta charset="utf-8"><title>成像型空间分析：已完成阶段结果</title><style>body{font:16px/1.7 system-ui;max-width:1150px;margin:30px auto;padding:0 20px;color:#20343f}img{max-width:100%}table{display:block;overflow:auto;border-collapse:collapse;font-size:13px}td,th{border:1px solid #ccd5df;padding:7px}th{background:#edf3f6}.note{background:#fff2ce;padding:15px}</style><h1>成像型空间分析：已完成阶段结果</h1><p>2026-11-15｜WEHI R4 / CoVarNet K15</p><p class="note">本页仅包含已完成的成像数据分析。四张Visium的完整R4参考解卷积仍在运行，不在本页宣称完成。</p><h2>主要观察</h2><p>六张乳腺Xenium 5k的ACKR1–PI16在100μm网格呈弱正相关（Spearman约0.01–0.20）。这表示区域RNA密度共变，不等同于精确细胞亚型丰度或细胞接触；前一轮细胞级条件邻近检验仍为阴性。</p><p>CM12的ESM1–RGS5在六张乳腺切片呈正相关，但ESM1–FOLR2关系不一致，不能将两节点的支持扩展为完整三节点生态位。CM04作为动脉–平滑肌对照一并展示。</p><p>肾癌低面板Xenium及两份肺癌CosMx缺少部分核心marker，精确核心投射标为不可测。CosMx另外定义大类血管候选，关联总体较弱；这不是CM01/12/04复现。</p><h2>分析定义与独立复核</h2><p>乳腺Xenium使用原生RNA计数，100/200μm网格，每格至少10个QC细胞；marker计数除以网格原生RNA总量。核心活动保留原R4的对应节点W权重，缺测不填零；图中每个面板以自身p99缩放。60邻居反平方行归一化双变量Moran描述空间聚集。全部坐标及RNA总量与原生文件逐细胞一致，144个随机网格独立从原始RNA复算通过。</p><h2>核心可测性</h2>''',table(q[(q.scope=='prespecified_core_proxy')&(q.grid_um==100)][['section','cm','missing','status','retained_W_fraction']]),'<h2>乳腺核心边：100μm</h2>',table(e[e.grid_um==100]),'<h2>乳腺尺度敏感性：200μm</h2>',table(e[e.grid_um==200])]
for key in ['breast_S01','breast_S02','breast_S03','breast_S04','breast_S05','breast_S06','renal_Xenium']:
    shutil.copy2(R/'imaging'/key/'core_activity.png',O/'figures'/f'{key}.png');parts.append(f'<img src="figures/{key}.png">')
parts+=['''<h2>肺癌CosMx：独立的大类血管分析</h2><p>Lung12和Lung13按归档名预选。细胞联合键精确匹配，排除背景cell_ID=0及非基因列，RNA≥50且检出基因≥20。候选大类至少2个实测marker，排除多类重叠候选；网格内比例为特征，内皮和伙伴等权。25/50μm网格至少3个QC细胞，Moran仅在同一FOV且超过60格时计算；无跨FOV连边，不把FOV当独立患者。坐标采用<a href="https://www.brukerspatialbiology.com/wp-content/uploads/2024/11/MK6578_CosMx_Human_Lymph_Node_FFPE_Dataset_webpage.html">制造商0.12028μm/px平台规范</a>，属于平台标定假设。比例构成和候选身份筛选均可能影响相关，不据负相关推断细胞排斥。</p>''',table(c)]
for key in ['Lung12','Lung13']:
    shutil.copy2(R/'cosmx_broad'/key/'core_activity.png',O/'figures'/f'{key}.png');parts.append(f'<img src="figures/{key}.png">')
parts+=['<h2>结果保存</h2><p>逐细胞和网格数据留在服务器：</p><code>'+str(R)+'</code><p>方法参考：<a href="https://www.nature.com/articles/s41586-025-09053-4">CoVarNet原文</a>；本页采用成像marker密度代理和另列的大类候选，未宣称直接复现全部原网络或证明机制。</p></html>']
(O/'report.html').write_text(''.join(parts))
for group,names in {'imaging':['core_marker_spatial_edges.tsv','activity_qualification.tsv','marker_availability.tsv','independent_audit.json','complete.json'],'cosmx_broad':['sample_core_edge_summary.tsv','marker_availability.tsv','complete.json']}.items():
    d=O/'tables'/group;d.mkdir(parents=True,exist_ok=True)
    for name in names:shutil.copy2(R/group/name,d/name)
manifest={str(p.relative_to(O)):hashlib.sha256(p.read_bytes()).hexdigest() for p in O.rglob('*') if p.is_file()};(O/'manifest.json').write_text(json.dumps(manifest,indent=2))
with tarfile.open(R/'imaging_completed_report.tar.gz','w:gz') as t:t.add(O,arcname=O.name)
print(hashlib.sha256((R/'imaging_completed_report.tar.gz').read_bytes()).hexdigest(),flush=True)
