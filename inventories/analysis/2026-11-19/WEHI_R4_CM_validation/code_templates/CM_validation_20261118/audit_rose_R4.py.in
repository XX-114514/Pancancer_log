"""Raw CSV/GEO patient reconstruction; all scores, exact U and permutations."""
from pathlib import Path
import csv,gzip,re,json,hashlib
import numpy as np,pandas as pd
from scipy.stats import rankdata
R=Path('${PROJECT_ARCHIVE_ROOT}/CM_validation_20261118_v1');B=R/'bulk_R4_candidates';O=B/'rose_response_v1';D=R/'clinical/rose_patients_v2';P=Path('${PANCANCER_ROOT}/Project_v5/bulk_cohorts_20260904/ici_bulk/rose2021_urothelial');sig=pd.read_csv(B/'candidate_signatures.tsv',sep='\t');wanted=set(sig.gene)
with gzip.open(P/'sample_key.csv.gz','rt') as fh:
 reader=csv.reader(fh);next(reader);key={row[0]:[x.strip() for x in row[1].split(',')] for row in reader}
assert len(key)==89 and sum(map(len,key.values()))==90
series=(R/'sources/rose_metadata/GSE176307.soft.txt').read_text();assert 'Sample BACI165 was sequenced twice.' in series
chars=[]
with gzip.open(P/'series_matrix.txt.gz','rt') as fh:
 for line in fh:
  if line.startswith('!series_matrix_table_begin'):break
  if not line.startswith('!Sample_'):continue
  row=next(csv.reader([line],delimiter='\t'))
  if row[0]=='!Sample_title':titles=row[1:]
  elif row[0]=='!Sample_geo_accession':gsm=row[1:]
  elif row[0]=='!Sample_characteristics_ch1':chars.append(row[1:])
records=[]
for i,title in enumerate(titles):
 assert title.startswith('Patient sample ');sample=title[len('Patient sample '):];patient='BACI165' if sample in ['BACI165_1','BACI165_2'] else sample;assert patient in key
 if patient=='BACI165':
  text=(R/'sources/rose_metadata'/(gsm[i]+'.soft.txt')).read_text();rna,=re.findall(r'^!Sample_description = (.+)$',text,re.M);assert rna in key[patient]
 else:rna,=key[patient]
 d={'patient':patient,'GSM':gsm[i],'expression_key':rna}
 for values in chars:
  if not values[i].strip():continue
  k,v=values[i].split(':',1);d[k.strip()]=v.strip()
 records.append(d)
m=pd.DataFrame(records);assert len(m)==90 and m.patient.nunique()==89 and m.expression_key.is_unique
bridge=pd.read_csv(D/'sample_patient_bridge_PRIVATE.tsv',sep='\t',dtype=str,keep_default_na=False).set_index('GSM')
for row in records:
 for field in ['patient','expression_key','io.response','io.therapy','io.lot','overall survival','alive','pfs','progressed']:assert row[field]==bridge.loc[row['GSM'],field],(row['GSM'],field)
expr={};names=[]
with gzip.open(P/'GSE176307_salmon_tpm.tsv.gz','rt') as fh:
 reader=csv.reader(fh,delimiter='\t');columns=next(reader)[1:]
 for row in reader:
  names.append(row[0])
  if row[0] in wanted:expr[row[0]]=np.array(row[1:],float)
assert len(names)==58387 and len(set(names))==58387 and len(columns)==92
X=pd.DataFrame.from_dict(expr,orient='index',columns=columns);scores=pd.read_csv(O/'scores_PRIVATE.tsv.gz',sep='\t');a=pd.read_csv(O/'response_associations.tsv',sep='\t');meta=m.drop_duplicates('patient').set_index('patient');rng=np.random.default_rng(2026111906);maxerr=0.;comparisons=0;cache={}
def exact_p(n1,n0,u):
 if (n1,n0) not in cache:
  dist={(0,j):np.array([1.]) for j in range(n0+1)}
  for i in range(1,n1+1):
   dist[i,0]=np.array([1.])
   for j in range(1,n0+1):
    v=np.zeros(i*j+1);v[j:j+len(dist[i-1,j])]+=dist[i-1,j];v[:len(dist[i,j-1])]+=dist[i,j-1];dist[i,j]=v
  cache[n1,n0]=dist[n1,n0]
 d=cache[n1,n0];return min(1.,2*d[:int(min(u,n1*n0-u))+1].sum()/d.sum())
for policy in ['mean_explicit_repeat_TPM','exclude_explicit_repeat_patient']:
 patients=sorted(meta.index if policy=='mean_explicit_repeat_TPM' else [p for p in meta.index if p!='BACI165']);raw=np.stack([X[key[p]].to_numpy().mean(axis=1) for p in patients]);L=np.log2(raw+.001);sd=L.std(axis=0,ddof=1);valid=sd>1e-8;Z=(L-L.mean(axis=0))/sd;md=meta.loc[patients];response=md['io.response'].map({'CR':1,'PR':1,'SD':0,'PD':0});known=response.notna().to_numpy();y=response[known].to_numpy(int);test=md[known];lines=test['io.lot'].map(int).clip(upper=3).map(str);strata=(test['io.therapy']+'|line_'+lines).to_numpy();indices=[np.flatnonzero(strata==s) for s in sorted(set(strata))];Y=np.tile(y,(9999,1))
 for ix in indices:
  for k in range(9999):Y[k,ix]=rng.permutation(y[ix])
 for (branch,cm),g in sig.groupby(['branch','cm']):
  ix=X.index.get_indexer(g.gene);ix=ix[ix>=0];ix=ix[valid[ix]];assert len(ix)>=48;value=Z[:,ix].mean(axis=1);saved=scores[(scores.policy==policy)&(scores.branch==branch)&(scores.cm==cm)].set_index('patient').loc[patients];err=np.max(abs(value-saved.score));maxerr=max(maxerr,float(err));assert err<1e-12 and np.allclose(response,saved.response,equal_nan=True)
  v=value[known];difference=v[y==1,None]-v[y==0][None,:];u=float((difference>0).sum()+.5*(difference==0).sum());auc=u/difference.size;result=a[(a.policy==policy)&(a.branch==branch)&(a.cm==cm)].iloc[0];assert result.response_patients==len(y) and result.responders==y.sum() and result.unknown_response==int((~known).sum());assert result.MWU_method=='exact' and len(set(v))==len(v);assert abs(auc-result.auc_higher_score_response)<1e-12;assert abs(exact_p(int(y.sum()),int((1-y).sum()),u)-result.p_MWU)<1e-12
  ranks=rankdata(v);center=sum(ranks[ix].sum()*y[ix].mean() for ix in indices);stat=ranks@y-center;pv=(1+(abs(Y@ranks-center)>=abs(stat)-1e-10).sum())/10000;assert abs(pv-result.p_stratified_permutation)<1e-12;comparisons+=1
h=pd.read_csv(O/'Hugo_response_joint_update.tsv',sep='\t');r=pd.read_csv(O/'Riaz_response_joint_update.tsv',sep='\t');hp=h[['p_MWU','p_stratified_permutation']].to_numpy().ravel();rp=r[['p_MWU','p_prior_ipi_permutation']].to_numpy().ravel();ap=a[['p_MWU','p_stratified_permutation']].to_numpy().ravel();p=np.r_[hp,rp,ap];q=np.r_[h[['q_three_ICI_MWU','q_three_ICI_stratified']].to_numpy().ravel(),r[['q_three_ICI_MWU','q_three_ICI_prior_ipi']].to_numpy().ravel(),a[['q_three_ICI_MWU','q_three_ICI_stratified']].to_numpy().ravel()];order=np.argsort(p);expected=np.minimum.accumulate((p[order]*len(p)/np.arange(1,len(p)+1))[::-1])[::-1].clip(0,1);assert np.allclose(expected,q[order],atol=1e-12) and len(p)==480
for old,updated,fields in [(B/'hugo_response_v1/response_associations.tsv',h,['p_MWU','p_stratified_permutation']),(B/'riaz_response_v1/response_associations.tsv',r,['p_MWU','p_prior_ipi_permutation'])]:assert np.allclose(pd.read_csv(old,sep='\t')[fields],updated[fields],atol=1e-14)
proof=dict(status='PASS_RAW_GEO_CSV_PATIENT_REPEAT_RECONCILIATION_ALL_SCORES_EXACT_U_PERMUTATION_AND_JOINT_BH',patients=89,clinical_samples=90,score_values=len(scores),comparisons=comparisons,joint_tests=len(p),joint_q05=int((q<.05).sum()),max_score_error=maxerr,association_sha256=hashlib.sha256((O/'response_associations.tsv').read_bytes()).hexdigest(),limitation='Timing remains unknown; numerical/identity audit does not establish pretreatment prediction or prospective external validation.')
(O/'independent_audit.json').write_text(json.dumps(proof,indent=2));(D/'independent_audit.json').write_text(json.dumps(dict(status='PASS_RAW_GEO_AND_AUTHOR_KEY_ALL90_SAMPLES_89_PATIENTS',linked_full_audit=str(O/'independent_audit.json'),timing='UNRESOLVED_NOT_BASELINE_VERIFIED'),indent=2));print(json.dumps(proof),flush=True)
