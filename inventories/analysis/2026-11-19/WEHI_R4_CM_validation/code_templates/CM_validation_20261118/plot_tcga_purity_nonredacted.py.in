from pathlib import Path
import json
import pandas as pd,numpy as np
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
R=Path('${PROJECT_ARCHIVE_ROOT}/CM_validation_20261118_v1');O=R/'bulk_R4_candidates/TCGA_leukocyte_purity_v3_nonredacted'
assert json.loads((O/'independent_audit.json').read_text())['status'].startswith('PASS_')
a=pd.read_csv(O/'adjusted_associations.tsv',sep='\t');a=a[(a.branch=='original_network_members')&(a.policy=='LF_single')&(a.model=='purity_age_sex')]
mods=['CM%02d'%i for i in range(1,16)];cancers=sorted(a.cancer.unique());q=a.pivot(index='cancer',columns='cm',values='q_joint_with_unadjusted').reindex(index=cancers,columns=mods)
fig,axes=plt.subplots(1,2,figsize=(14,11),sharey=True,layout='constrained');cmap=plt.get_cmap('RdBu_r').copy();cmap.set_bad('#dddddd')
for ax,field,title in zip(axes,['matched_unadjusted_rho','partial_rho'],['Unadjusted (same complete-case patients)','Conditioned on purity, age and sex']):
 mat=a.pivot(index='cancer',columns='cm',values=field).reindex(index=cancers,columns=mods)
 im=ax.imshow(mat,cmap=cmap,vmin=-1,vmax=1,aspect='auto');ax.set_xticks(range(15),mods,rotation=90);ax.set_yticks(range(len(cancers)),cancers);ax.set_title(title,fontsize=12)
 if field=='partial_rho':
  y,x=np.where(q.to_numpy()<.05);ax.scatter(x,y,s=5,c='black')
fig.colorbar(im,ax=axes,label='Rank correlation / partial rank correlation',shrink=.6)
fig.suptitle('TCGA R4 module scores and methylation leukocyte fraction (redacted cases excluded)\nExploratory within-cancer associations; grey = not assessable',fontsize=14)
fig.supxlabel('Primary signature branch; single-aliquot LF. Dots: joint BH q < 0.05 over 5,400 tests.\nConditioning on composition is not causal adjustment or biomarker validation.',fontsize=10)
fig.savefig(O/'all_modules_purity_sensitivity.png',dpi=180);plt.close(fig)
a.to_csv(O/'primary_branch_purity_age_sex.tsv',sep='\t',index=False)
print('FIGURE_AND_PRIMARY_SUMMARY_WRITTEN')
