"""Archived timing-unresolved Rose cohort: descriptive response association only."""
from pathlib import Path
import json,hashlib
import pandas as pd,numpy as np
from scipy.stats import rankdata,mannwhitneyu
from statsmodels.stats.multitest import multipletests
R=Path('${PROJECT_ARCHIVE_ROOT}/CM_validation_20261118_v1');B=R/'bulk_R4_candidates';O=B/'rose_response_v1';O.mkdir(exist_ok=False);D=R/'clinical/rose_patients_v2';P=Path('${PANCANCER_ROOT}/Project_v5/bulk_cohorts_20260904/ici_bulk/rose2021_urothelial')
plan=dict(status='FROZEN_BEFORE_ROSE_RESPONSE_TESTS',role='Retrospective archived-cohort response association; biopsy timing UNKNOWN, NOT pretreatment predictive validation',signatures='fixed15CM x2branches; no selected genes, direction or thresholds',score='exact unique gene symbols only; log2(submittedTPM+.001), per-gene patient z ddof1, mean>=48 mapped variable signature genes; no gene remapping or new normalization',policies=['mean_explicit_repeat_TPM','exclude_explicit_repeat_patient'],unknown_response='retain in outcome-blind scoring cohort, exclude from response tests; do not impute',tests='two-sided exact MWU if no ties; fixed-direction AUC (higher score associated with response), plus9999 response-label permutations within exact ICI drug x treatment line(1,2,3+) strata, centered within strata',family='joint480 planned tests: previous360 Hugo/Riaz plus120 Rose; retain and label differing cohort timing qualification, no pooled cohort effect',seed=2026111906,limitations='Unresolved biopsy-to-ICI timing prevents baseline prediction claims. No untreated comparator, external prospective validation or survival analysis. Clinical covariates and tissue site may confound; previously used cohort, not untouched validation.')
(O/'plan.json').write_text(json.dumps(plan,indent=2));meta=pd.read_csv(D/'patient_clinical_PRIVATE.tsv',sep='\t',index_col='patient',keep_default_na=False);x=pd.read_csv(P/'GSE176307_salmon_tpm.tsv.gz',sep='\t',index_col=0);assert x.index.is_unique;assert len(meta)==89
sigpath=B/'candidate_signatures.tsv';assert hashlib.sha256(sigpath.read_bytes()).hexdigest()=='98907c4931b027282fde7a0a5a347b7ba36e5945f992ccad522555f31bddd5b2';sig=pd.read_csv(sigpath,sep='\t');wanted=sorted(set(sig.gene)&set(x.index));x=x.loc[wanted];rng=np.random.default_rng(plan['seed']);rows=[];scores=[];coverage=[]
for policy in plan['policies']:
 m=meta if policy=='mean_explicit_repeat_TPM' else meta[meta.RNA_column_count.eq(1)];m=m.sort_index();raw=pd.DataFrame({pt:x[row.RNA_columns.split('|')].mean(axis=1) for pt,row in m.iterrows()}).T;L=np.log2(raw+.001);sd=L.std(ddof=1);valid=sd>1e-8;Z=(L-L.mean())/sd
 response=m['io.response'].map({'CR':1,'PR':1,'SD':0,'PD':0});known=response.notna();testmeta=m[known].copy();y=response[known].to_numpy(int);line=pd.to_numeric(testmeta['io.lot'],errors='coerce');assert line.notna().all() and line.ge(1).all();linecat=line.clip(upper=3).astype(int).astype(str);strata=(testmeta['io.therapy']+'|line_'+linecat).to_numpy();indices=[np.flatnonzero(strata==s) for s in sorted(set(strata))];Y=np.tile(y,(9999,1))
 for ix in indices:
  for k in range(len(Y)):Y[k,ix]=rng.permutation(y[ix])
 mixed=sum(len(ix) for ix in indices if len(set(y[ix]))==2);m.assign(response=response,permutation_stratum=pd.Series(strata,index=testmeta.index)).to_csv(O/(policy+'_design_PRIVATE.tsv'),sep='\t')
 for (branch,cm),g in sig.groupby(['branch','cm']):
  genes=[s for s in g.gene if s in Z.columns and valid[s]];coverage.append(dict(policy=policy,branch=branch,cm=cm,mapped_variable_genes=len(genes),missing_exact_genes='|'.join(s for s in g.gene if s not in Z.columns)));assert len(genes)>=48
  value=Z[genes].mean(axis=1);v=value[known].to_numpy();rank=rankdata(v);n1=int(y.sum());n0=len(y)-n1;u=float(rank@y-n1*(n1+1)/2);auc=u/(n1*n0);method='exact' if len(set(v))==len(v) else 'asymptotic';mw=mannwhitneyu(v[y==1],v[y==0],alternative='two-sided',method=method);assert np.isclose(mw.statistic,u)
  center=sum(rank[ix].sum()*y[ix].mean() for ix in indices);obs=rank@y-center;permuted=Y@rank-center;pv=(1+(abs(permuted)>=abs(obs)-1e-10).sum())/10000 if mixed else np.nan
  rows.append(dict(policy=policy,branch=branch,cm=cm,scoring_patients=len(m),response_patients=len(y),responders=n1,nonresponders=n0,unknown_response=int((~known).sum()),auc_higher_score_response=auc,p_MWU=float(mw.pvalue),MWU_method=method,p_stratified_permutation=pv,mixed_stratum_patients=mixed,biopsy_timing='UNKNOWN_NOT_BASELINE_VALIDATION'))
  scores.extend(dict(policy=policy,branch=branch,cm=cm,patient=pt,score=float(value[pt]),response=float(response[pt])) for pt in m.index)
a=pd.DataFrame(rows);h=pd.read_csv(B/'hugo_response_v1/response_associations.tsv',sep='\t');r=pd.read_csv(B/'riaz_response_v1/response_associations.tsv',sep='\t');assert json.loads((B/'riaz_response_v1/independent_audit.json').read_text())['status'].startswith('PASS_')
hcols=['p_MWU','p_stratified_permutation'];rcols=['p_MWU','p_prior_ipi_permutation'];acols=['p_MWU','p_stratified_permutation']
# Riaz column name is fixed by its audited table, never guessed.
assert all(k in r.columns for k in rcols)
hp=h[hcols].to_numpy().ravel();rp=r[rcols].to_numpy().ravel();ap=a[acols].to_numpy().ravel();p=np.r_[hp,rp,ap];assert len(p)==480 and np.isfinite(p).all();q=multipletests(p,method='fdr_bh')[1]
h[['q_three_ICI_MWU','q_three_ICI_stratified']]=q[:len(hp)].reshape(-1,2);r[['q_three_ICI_MWU','q_three_ICI_prior_ipi']]=q[len(hp):len(hp)+len(rp)].reshape(-1,2);a[['q_three_ICI_MWU','q_three_ICI_stratified']]=q[-len(ap):].reshape(-1,2)
a.to_csv(O/'response_associations.tsv',sep='\t',index=False);h.to_csv(O/'Hugo_response_joint_update.tsv',sep='\t',index=False);r.to_csv(O/'Riaz_response_joint_update.tsv',sep='\t',index=False);pd.DataFrame(scores).to_csv(O/'scores_PRIVATE.tsv.gz',sep='\t',index=False);pd.DataFrame(coverage).to_csv(O/'gene_coverage.tsv',sep='\t',index=False)
proof=dict(status='ROSE_TIMING_UNRESOLVED_RESPONSE_ASSOCIATIONS_PENDING_INDEPENDENT_AUDIT',score_rows=len(scores),Rose_tests=len(ap),joint_tests=len(p),joint_q05=int((q<.05).sum()),limitations=plan['limitations']);(O/'complete.json').write_text(json.dumps(proof,indent=2));print(json.dumps(proof),flush=True);print(a[a.cm.eq('CM12')].to_string(index=False))
