"""Independent pandas score, pairwise AUC, U distribution, permutation and BH replay."""
from pathlib import Path
import json,hashlib
import numpy as np,pandas as pd,anndata as ad
from scipy.stats import rankdata
R=Path('${PROJECT_ARCHIVE_ROOT}/CM_validation_20261118_v1');B=R/'bulk_R4_candidates';O=B/'riaz_response_v1'
sig=pd.read_csv(B/'candidate_signatures.tsv',sep='\t');scores=pd.read_csv(O/'scores_PRIVATE.tsv.gz',sep='\t');result=pd.read_csv(O/'response_associations.tsv',sep='\t');maxerr=0.;tested=0
cache={}
def exact_p(n1,n0,u):
 if (n1,n0) not in cache:
  dist={(0,j):np.array([1.]) for j in range(n0+1)}
  for i in range(1,n1+1):
   dist[i,0]=np.array([1.])
   for j in range(1,n0+1):
    v=np.zeros(i*j+1);v[j:j+len(dist[i-1,j])]+=dist[i-1,j];v[:len(dist[i,j-1])]+=dist[i,j-1];dist[i,j]=v
  cache[n1,n0]=dist[n1,n0]
 d=cache[n1,n0];return min(1.,2*d[:int(min(u,n1*n0-u))+1].sum()/d.sum())
for version in ['riaz_inputs_v2','riaz_inputs_v1']:
 a=ad.read_h5ad(B/version/'baseline_candidate_expression_PRIVATE.h5ad');X=pd.DataFrame(a.X,index=a.obs_names,columns=a.var_names);Z=(X-X.mean())/X.std(ddof=1)
 for endpoint in ['CRPR_vs_SDPD','CRPR_vs_PD']:
  m=a.obs[a.obs.eligible_baseline_response].copy()
  if endpoint=='CRPR_vs_PD':m=m[m.BOR.astype(str)!='SD']
  y=m.BOR.astype(str).isin(['PR','CR']).to_numpy(int);strata=m.Cohort.astype(str).to_numpy();blocks=[np.flatnonzero(strata==v) for v in sorted(set(strata))];rng=np.random.default_rng(2026111819);Y=np.tile(y,(9999,1))
  for ix in blocks:
   for k in range(len(Y)):Y[k,ix]=rng.permutation(y[ix])
  for (branch,cm),g in sig.groupby(['branch','cm']):
   genes=[v for v in g.gene if v in X.columns and X[v].std(ddof=1)>1e-8];value=Z[genes].mean(axis=1)
   s=scores[(scores.input_version==version)&(scores.branch==branch)&(scores.cm==cm)].set_index('sample').loc[a.obs_names];assert len(s)==51
   assert np.allclose(value,s.score,atol=1e-12);assert np.array_equal(s.patient,a.obs.PatientID.astype(str));maxerr=max(maxerr,float(abs(value-s.score).max()))
   v=value.loc[m.index].to_numpy();pair=v[y==1,None]-v[y==0][None,:];u=float((pair>0).sum()+.5*(pair==0).sum());auc=u/pair.size
   row=result[(result.input_version==version)&(result.endpoint==endpoint)&(result.branch==branch)&(result.cm==cm)].iloc[0]
   assert row.patients==len(m) and row.responders==y.sum() and row.nonresponders==(1-y).sum() and row.genes==len(genes)
   assert np.isclose(auc,row.auc_higher_score_response);assert row.MWU_method=='exact' and len(set(v))==len(v)
   assert np.isclose(exact_p(int(y.sum()),int((1-y).sum()),u),row.p_MWU,atol=1e-12)
   ranks=rankdata(v);center=sum(ranks[ix].sum()*y[ix].mean() for ix in blocks);observed=ranks@y-center;pp=(1+(abs(Y@ranks-center)>=abs(observed)-1e-10).sum())/10000
   assert np.isclose(pp,row.p_prior_ipi_permutation);tested+=2
h=pd.read_csv(O/'Hugo_response_joint_q.tsv',sep='\t');original=pd.read_csv(B/'hugo_response_v1/response_associations.tsv',sep='\t');
for col in original.columns:
 if pd.api.types.is_numeric_dtype(original[col]):assert np.allclose(h[col],original[col],atol=1e-15,equal_nan=True)
 else:assert h[col].fillna('').equals(original[col].fillna(''))
p=np.r_[h[['p_MWU','p_stratified_permutation']].to_numpy().ravel(),result[['p_MWU','p_prior_ipi_permutation']].to_numpy().ravel()];idx=np.argsort(p);q=np.empty(len(p));q[idx]=np.minimum(1,np.minimum.accumulate((p[idx]*len(p)/np.arange(1,len(p)+1))[::-1])[::-1])
reported=np.r_[h[['q_ICI_joint_MWU','q_ICI_joint_stratified']].to_numpy().ravel(),result[['q_ICI_joint_MWU','q_ICI_joint_prior_ipi']].to_numpy().ravel()];assert np.allclose(q,reported,atol=1e-12)
proof=dict(status='PASS_ALL_RIAZ_SCORES_PATIENT_GROUPS_EXACT_U_PERMUTATION_AND_CROSS_COHORT_BH',score_values=len(scores),Riaz_tests=tested,joint_tests=len(p),max_score_error=maxerr,association_sha256=hashlib.sha256((O/'response_associations.tsv').read_bytes()).hexdigest(),limitations='numerical replay only; not independent external predictive validation')
(O/'independent_audit.json').write_text(json.dumps(proof,indent=2));print(json.dumps(proof))
