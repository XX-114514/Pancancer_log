from pathlib import Path
import json,math,hashlib
import numpy as np,pandas as pd,anndata as ad
from scipy import sparse
from scipy.spatial import cKDTree
from statsmodels.stats.multitest import multipletests
R=Path('${PROJECT_ARCHIVE_ROOT}/CM_validation_20261118_v1');O=R/'imaging_breast_mural_states_v1';old=R/'imaging_breast_core_cells_v1';P=Path('${PANCANCER_ROOT}/Project_v3/runs/20261108_V4_native_coordinate_fix_v1');states=['pc_low_MYH11','MYH11_contractile'];tables={s:pd.read_csv(O/s/'proximity_tests.tsv',sep='\t') for s in states};blocks={s:pd.read_csv(O/s/'null_blocks.tsv.gz',sep='\t') for s in states};errors=[]
def verify(z,r,bt):
 forward=r.direction.startswith('ESM1');src=z['ec'] if forward else z['mural'];tgt=(z['mural']&(z['RGS5']>=r.threshold)) if forward else (z['ec']&(z['ESM1']>=r.threshold));pos=(z['ESM1'] if forward else z['RGS5'])[src]>=r.threshold;coords=z['xy'][src];near=cKDTree(z['xy'][tgt]).query_ball_point(coords,r.radius_um,return_length=True)>0 if tgt.any() else np.zeros(len(coords),bool)
 tiles=np.floor(coords/r.tile_um).astype(int);design=pd.DataFrame(dict(tx=tiles[:,0],ty=tiles[:,1],depth=z['depth'][src],pos=pos,near=near));expected=[]
 for _,g in design.groupby(['tx','ty'],sort=True):
  cuts=g.depth.quantile([.25,.5,.75]).to_numpy();q=(g.depth.to_numpy()[:,None]>=cuts).sum(axis=1)
  for lev in sorted(set(q)):
   h=g.iloc[np.flatnonzero(q==lev)];expected.append((len(h),int(h.pos.sum()),int(h.near.sum()),int((h.pos&h.near).sum())))
 assert expected==list(bt[bt.key==r.key][['n','k','near','observed']].itertuples(index=False,name=None))
 dist=np.array([1.]);mu=0.;infop=infon=0
 for n,k,h,obs in expected:
  v=np.zeros(k+1);denom=math.comb(n,k)
  for j in range(max(0,k-n+h),min(k,h)+1):v[j]=math.comb(h,j)*math.comb(n-h,k-j)/denom
  dist=np.convolve(dist,v);mu+=k*h/n
  if 0<k<n:infop+=k;infon+=n-k
 observed=int((pos&near).sum());assert observed==r.observed_count and abs(mu-r.expected_count)<1e-9;assert r.n_positive==int(pos.sum()) and r.n_target==int(tgt.sum());assert abs(dist.sum()-1)<1e-10
 eligible=len(pos)>=20 and tgt.sum()>=10 and infop>=10 and infon>=10;assert eligible==(r.status=='TESTED')
 if eligible:
  p=min(1.,sum(v for j,v in enumerate(dist) if abs(j-mu)>=abs(observed-mu)-1e-10));errors.append(abs(p-r.p_exact));assert errors[-1]<1e-10
for unit in ['S01','S02','S03','S04','S05','S06']:
 cf,=P.glob('outputs*/spatial_controls_v1/'+unit+'/cell_identity_view_PRIVATE.tsv.gz');c=pd.read_csv(cf,sep='\t');a=ad.read_h5ad(P/'inputs_direct_v1'/unit/'native_PRIVATE.h5ad',backed='r');receipt=json.loads((cf.parent/'complete.json').read_text());assert hashlib.sha256('\n'.join(a.obs_names.astype(str)).encode()).hexdigest()==receipt['native_cell_axis_SHA256']
 names=pd.Index(a.var.gene_symbol.astype(str) if 'gene_symbol' in a.var else a.var_names);gs=['ABCC9','KCNJ8','CSPG4','PDGFRB','MYH11','ACTA2','TAGLN','CNN1','RGS5','ESM1'];idx=sorted(names.get_loc(g) for g in gs);x=a[:,idx].X;x=x.toarray() if sparse.issparse(x) else x;x=np.expm1(x.astype(float));assert np.allclose(x,np.rint(x),atol=.001,rtol=1e-5);raw=pd.DataFrame(np.rint(x),columns=names[idx]);a.file.close();prior=np.load(old/(unit+'_core_PRIVATE.npz'));assert np.array_equal(prior['ESM1'],raw.ESM1) and np.array_equal(prior['RGS5'],raw.RGS5)
 parent=c.QC_keep.astype(str).str.lower().eq('true')&c.author_major.str.lower().str.contains('pvl|mural|perivascular|smooth')&~prior['ec'];program=raw[['ABCC9','KCNJ8','CSPG4','PDGFRB']].gt(0).sum(axis=1).ge(2)&raw[['ABCC9','KCNJ8']].gt(0).any(axis=1);contractile=raw.MYH11.gt(0)&raw[['ACTA2','TAGLN','CNN1']].gt(0).any(axis=1);expected={'pc_low_MYH11':(parent&program&raw.MYH11.eq(0)).to_numpy(),'MYH11_contractile':(parent&contractile).to_numpy()}
 for s in states:
  z=np.load(O/s/(unit+'_core_PRIVATE.npz'));assert np.array_equal(z['mural'],expected[s]);assert np.array_equal(z['ec'],prior['ec'])
  for k in ['xy','depth','ESM1','RGS5']:assert np.array_equal(z[k],prior[k])
  for r in tables[s][tables[s].section==unit].itertuples():verify(z,r,blocks[s])
 print(unit,'both raw identity masks and all32 exact tests PASS',flush=True)
priorproof=json.loads((old/'independent_audit.json').read_text());assert priorproof['status'].startswith('PASS_');assert hashlib.sha256((old/'proximity_tests.tsv').read_bytes()).hexdigest()==priorproof['association_sha256'];prior=pd.read_csv(old/'proximity_tests.tsv',sep='\t');prior['state']='original_broad_mural'
joined=[prior]
for s in states:
 t=tables[s].copy();t['state']=s;joined.append(t)
j=pd.concat(joined,ignore_index=True);assert len(j)==288 and not j.duplicated(['state','key']).any();good=j.status.eq('TESTED');p=j.loc[good,'p_exact'].to_numpy();order=np.argsort(p);q=np.minimum.accumulate((p[order]*len(p)/np.arange(1,len(p)+1))[::-1])[::-1].clip(0,1);unorder=np.empty_like(q);unorder[order]=q;assert np.allclose(unorder,multipletests(p,method='fdr_bh')[1],atol=1e-12);j.loc[good,'q_joint_identity_family']=unorder;j.to_csv(O/'joint_identity_tests.tsv',sep='\t',index=False)
proof=dict(status='PASS_all192new_tests_raw_identity_counts_exact_combinatorial_null_and_joint_BH',new_planned=192,new_tested=int(sum(t.status.eq('TESTED').sum() for t in tables.values())),joint_planned=288,joint_tested=int(good.sum()),joint_q05=int((j.q_joint_identity_family<.05).sum()),max_exact_p_error=max(errors),joint_sha256=hashlib.sha256((O/'joint_identity_tests.tsv').read_bytes()).hexdigest(),interpretation='same-cohort exploratory identity sensitivity; MYH11 zero is observed RNA zero, not proven biological absence; prior q_family retained for prior96 family only; no selection based on new outcome')
(O/'independent_audit.json').write_text(json.dumps(proof,indent=2));print(json.dumps(proof));print(j[(j.threshold==1)&(j.tile_um==200)&(j.radius_um==30)][['state','section','direction','n_positive','n_target','effect_fraction','q_joint_identity_family','status']].to_string(index=False))
