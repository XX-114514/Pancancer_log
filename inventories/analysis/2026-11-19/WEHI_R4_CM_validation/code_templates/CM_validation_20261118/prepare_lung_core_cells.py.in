"""Prospective lung marker-supported proxies; no author or exact R4 subtype claim."""
from pathlib import Path
import json,hashlib
import numpy as np,pandas as pd,h5py
from scipy.sparse import csc_matrix
R=Path('${PROJECT_ARCHIVE_ROOT}/CM_validation_20261118_v1');I=R/'sources/lung_prime5k_10x';O=R/'imaging_lung_core_v1';O.mkdir(exist_ok=False)
assert json.loads((I/'independent_input_audit.json').read_text())['status'].startswith('PASS_')
plan=dict(stage='frozen_before_new_lung_proximity_results',donors=1,platform='XeniumPrime5K',scope='single-section marker-supported spatial sensitivity; not untouched multicohort clinical validation',basic_QC='gene-expression counts>=50 and detected gene-expression features>=20; finite native centroids and positive cell area',nuclear_policies=['nucleus_count>=1 primary','all cells passing other QC sensitivity including3121 zero-nucleus boundary-segmented cells'],EC='>=2 primary or>=3 sensitivity among PECAM1/CDH5/KDR/ERG/CLDN5 AND CDH5 or ERG detected; exclude >=2 PROX1/PDPN/FLT4 lymphatic program',PC='>=2 ABCC9/KCNJ8/CSPG4/PDGFRB AND ABCC9 or KCNJ8 detected; MYH11/ACTA2/TAGLN/CNN1 unmeasured so no contractile exclusion possible',MF='both CD68 and CSF1R detected; myeloid proxy, not exact macrophage subtype',conflicts='exclude EPCAM>=2 RNA or both CD3E/CD3G or>=2 CD79A/CD79B/MS4A1; exclude overlap of EC/PC/MF support masks',auxiliary_threshold='>=1RNA unless explicitly stated; ESM1/RGS5/FOLR2 never used in identity gate',tests='all6 ordered pairs of3 core proxies x2 marker thresholds(1,2) x2 radii(30,50um) x2 tiles(200,400um) x2 EC gates x2 nuclear policies=192 planned; exact blocked-label conditional null as prior breast; joint BH with audited prior274 tests, all exclusions retained',interpretation='two-way proximity tests do not prove simultaneous three-cell hub or ligand receptor signaling; absent contractile markers prevent precise pericyte exclusion',coordinate_documentation='https://www.10xgenomics.com/support/software/xenium-onboard-analysis/3.2/analysis/xoa-output-understanding-outputs')
(O/'plan.json').write_text(json.dumps(plan,indent=2));receipt=json.loads((I/'complete.json').read_text())
for f in receipt['files']:assert hashlib.sha256((I/f['file']).read_bytes()).hexdigest()==f['sha256']
with h5py.File(I/'cell_feature_matrix.h5') as f:
 m=f['matrix'];bc=m['barcodes'].asstr()[:];genes=m['features/name'].asstr()[:];types=m['features/feature_type'].asstr()[:];x=csc_matrix((m['data'][:],m['indices'][:],m['indptr'][:]),shape=tuple(m['shape'][:]))
c=pd.read_csv(I/'cells.csv.gz').set_index('cell_id').loc[bc];gex=x[types=='Gene Expression'];depth=np.asarray(gex.sum(axis=0,dtype=np.int64)).ravel();detected=np.asarray((gex>0).sum(axis=0)).ravel();assert np.array_equal(depth,c.transcript_counts)
needed=['PECAM1','CDH5','KDR','ERG','CLDN5','PROX1','PDPN','FLT4','ABCC9','KCNJ8','CSPG4','PDGFRB','CD68','CSF1R','EPCAM','CD3E','CD3G','CD79A','CD79B','MS4A1','ESM1','RGS5','FOLR2'];assert set(needed)<=set(genes[types=='Gene Expression']);gi={g:int(np.flatnonzero(genes==g)[0]) for g in needed};raw=x[[gi[g] for g in needed]].toarray().T;v={g:raw[:,j] for j,g in enumerate(needed)}
np.savez_compressed(O/'selected_counts_PRIVATE.npz',counts=raw,genes=np.array(needed),barcodes=bc.astype(str),xy=c[['x_centroid','y_centroid']].to_numpy(),depth=depth,detected=detected,nucleus_count=c.nucleus_count.to_numpy())
positive=lambda gs:sum(v[g]>0 for g in gs)
base=(depth>=50)&(detected>=20)&np.isfinite(c[['x_centroid','y_centroid']]).all(axis=1).to_numpy()&c.cell_area.gt(0).to_numpy();exclude=(v['EPCAM']>=2)|(positive(['CD3E','CD3G'])>=2)|(positive(['CD79A','CD79B','MS4A1'])>=2);lymph=positive(['PROX1','PDPN','FLT4'])>=2;pc=(positive(['ABCC9','KCNJ8','CSPG4','PDGFRB'])>=2)&((v['ABCC9']>0)|(v['KCNJ8']>0));mf=(v['CD68']>0)&(v['CSF1R']>0);rows=[]
for ecgate in [2,3]:
 ec=(positive(['PECAM1','CDH5','KDR','ERG','CLDN5'])>=ecgate)&((v['CDH5']>0)|(v['ERG']>0))&~lymph;overlap=(ec.astype(int)+pc.astype(int)+mf.astype(int))>1
 for policy in ['nucleated','all_QC']:
  key=f'EC{ecgate}_{policy}';qc=base&~exclude&~overlap&(c.nucleus_count.ge(1).to_numpy() if policy=='nucleated' else True);masks={'EC':qc&ec,'PC':qc&pc,'MF':qc&mf};np.savez_compressed(O/(key+'_cells_PRIVATE.npz'),xy=c[['x_centroid','y_centroid']].to_numpy(),depth=depth,**masks,ESM1=v['ESM1'],RGS5=v['RGS5'],FOLR2=v['FOLR2'])
  for node,marker in [('EC','ESM1'),('PC','RGS5'),('MF','FOLR2')]:
   for k in [1,2]:rows.append(dict(setting=key,EC_gate=ecgate,nuclear_policy=policy,node=node,marker=marker,threshold=k,basic_QC=int(base.sum()),kept_QC=int(qc.sum()),lineage_cells=int(masks[node].sum()),marker_positive=int((masks[node]&(v[marker]>=k)).sum()),zero_nucleus_kept=int((qc&c.nucleus_count.eq(0).to_numpy()).sum()),overlap_excluded=int((base&overlap).sum())))
pd.DataFrame(rows).to_csv(O/'qualification.tsv',sep='\t',index=False);(O/'preparation_complete.json').write_text(json.dumps(dict(status='complete_raw_input_hashes_cell_axis_gene_only_depth_and_prospective_identity_masks',input_cells=len(c),settings=4,planned_tests=192),indent=2));print(pd.DataFrame(rows).to_string(index=False))
