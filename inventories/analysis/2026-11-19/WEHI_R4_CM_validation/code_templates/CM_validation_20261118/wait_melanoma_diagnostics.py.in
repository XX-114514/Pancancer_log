from pathlib import Path
import json,time,subprocess,fcntl,os
R=Path('${PROJECT_ARCHIVE_ROOT}/CM_validation_20261118_v1')
S=R/'spatial_melanoma';lock=(S/'diagnostics_wait.lock').open('w');fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
fitpid=json.loads((S/'reference_fit_launch.json').read_text())['pid'];start=time.time()
def status(**kw):
 kw.update(pid=os.getpid(),epoch=time.time());(S/'diagnostics_wait_status.json').write_text(json.dumps(kw,indent=2))
status(stage='waiting_reference_fit',fit_pid=fitpid)
while not (S/'reference/complete.json').exists():
 try:cmd=Path('/proc/%d/cmdline'%fitpid).read_bytes()
 except FileNotFoundError:cmd=b''
 if b'fit_50labels.py' not in cmd:
  status(stage='NEEDS_INSPECTION',reason='fit process absent without completion; not restarted');raise SystemExit(1)
 if time.time()-start>4*3600:
  status(stage='NEEDS_INSPECTION',reason='finite wait expired; fit not interrupted');raise SystemExit(1)
 time.sleep(30)
env=os.environ.copy();env.update(OPENBLAS_NUM_THREADS='4',OMP_NUM_THREADS='4')
with (S/'logs/separability.log').open('x') as f:
 p=subprocess.Popen(['${ENV_ROOT}/scanpy/bin/python',str(R/'check_melanoma_separability.py')],stdout=f,stderr=subprocess.STDOUT,env=env)
 status(stage='diagnostics_running',child_pid=p.pid);rc=p.wait()
status(stage='DIAGNOSTICS_WRITTEN_PENDING_REVIEW' if rc==0 else 'NEEDS_INSPECTION',exit_code=rc)
raise SystemExit(rc)
