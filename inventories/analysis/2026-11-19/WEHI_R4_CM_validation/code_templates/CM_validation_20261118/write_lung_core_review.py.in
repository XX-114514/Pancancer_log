# -*- coding: utf-8 -*-
from pathlib import Path
import json,pandas as pd
O=Path('${PROJECT_ARCHIVE_ROOT}/CM_validation_20261118_v1/imaging_lung_core_v1');proof=json.loads((O/'independent_audit.json').read_text());assert proof['status'].startswith('PASS_');j=pd.read_csv(O/'joint_imaging_tests.tsv',sep='\t');lung=j[j.platform_cohort=='lung'];breast=j[j.platform_cohort=='breast'];primary=lung[(lung.setting=='EC2_nucleated')&(lung.threshold==1)&(lung.radius_um==30)&(lung.tile_um==200)]
lines=['肺腺癌 Xenium Prime5K：CM12核心代理细胞空间检验（2026-11-19）','状态：原始输入、细胞身份、全部192设计及跨成像联合BH独立复核PASS。',f"单切片、单供体；{proof['lung_tested']}/192肺癌组合可检验。与既有乳腺{proof['prior_tested']}项联合，共{proof['joint_tested']}实际检验（480计划项含不可评估）。肺癌联合q<0.05组合数：{proof['lung_joint_q05']}。",'身份不使用目标marker：内皮>=2（敏感性>=3）PECAM1/CDH5/KDR/ERG/CLDN5且CDH5或ERG支持、排除淋巴内皮程序；PC代理>=2 ABCC9/KCNJ8/CSPG4/PDGFRB且ABCC9或KCNJ8支持；MF代理需CD68+CSF1R。排除身份重叠、上皮与T/B程序冲突。没有作者亚型注释，不能称exactR4。','该面板没有MYH11/ACTA2/TAGLN/CNN1，无法排除全部平滑肌状态；MYH11缺测绝不当作阴性。MF是髓系代理，不是已确证巨噬细胞亚型。','基本QC：>=50基因RNA及>=20检测基因，原生质心与正细胞面积；主分析核数>=1，敏感性含通过其他QC的无核边界分割细胞。gene-only深度不含控制/废弃码字。','完整设置：6个有序方向×2标记阈值×2半径×2空间块×2内皮门槛×2核政策=192。固定target，在source同谱系、空间块和块内深度四分位中置换目标marker标签；超几何分布精确卷积。','主设定（EC2、核数>=1、>=1目标RNA、30um半径、200um块）结果：']
for r in primary.itertuples():lines.append(f'{r.direction}: 阳性source={r.n_positive}，target={r.n_target}，观察邻近比例={100*r.observed_fraction:.3f}%，条件期望={100*r.expected_fraction:.3f}%，差={100*r.effect_fraction:.3f}百分点；P={r.p_exact:.6g}，联合q={r.q_joint_imaging:.6g}。')
old=breast.q_joint_identity_family.le(.05);new=breast.q_joint_imaging.le(.05);lines.extend([f'既有乳腺q更新：旧274-family显著组合{old.sum()}，新联合family保留{new.sum()}；失去阈值{(old&~new).sum()}，新增{(~old&new).sum()}。旧结果保留，合并解释需使用q_joint_imaging。','图示全部参数组合，未选择阳性门槛；细胞坐标图仅质心，不是病理图或分割边界审查。','限制：单供体、标记支持代理、分割及细胞身份误差、条件交换性假设。未见显著不等于证明不存在/等效。两两邻近不证明三类细胞同时组成hub，更不证明物理接触、配体受体机制、临床获益或因果。','输入来源：https://www.10xgenomics.com/datasets/xenium-human-lung-cancer-post-xenium-technote'])
(O/'结果说明.txt').write_text('\n'.join(lines)+'\n',encoding='utf-8');print('review_complete',len(primary),'primary rows')
