suppressPackageStartupMessages(library(survival));suppressPackageStartupMessages(library(jsonlite))
P <- '${PROJECT_ARCHIVE_ROOT}/CM_validation_20261118_v1/bulk_R4_candidates/TCGA_survival_v1_nonredacted'
O <- file.path(P,'piecewise_one_year_v1');stopifnot(!dir.exists(O));dir.create(O)
plan <- list(status='FROZEN_ALL_QUALIFIED_MODELS_ONE_YEAR_SCORE_SENSITIVITY',selection='All prior FIT_OK models, both branches/all15CM/all four adjustment sets. No p-value or PH-flag selection.',cut_days=365.25,model='Same complete-case patients and original outcome-blind score SD. Cox start-stop intervals at365.25days: score_sd + score_late(score_sd when interval starts at cutoff) + original covariates, Efron/model covariance. Early HR exp(beta_score), late HR exp(beta_score+beta_late); interaction tests time difference.',minimum='Original n>=100 retained; total events>=max(30,10*(original coefficients+1)); >=20events in each period; >=20patients followed beyond cutoff.',multiplicity='Joint BH over all prior3690 constant-HR score tests and all successful early/late/change Wald tests. Prior PH diagnostic tests remain their separate diagnostic family. No cutpoint search.',limitations='Exploratory fixed-cut sensitivity, not optimized change point, treatment response or causal effect. Other covariates still assumed proportional; this does not fix all global PH violations. Late effects conditional on survival/risk-set composition. No external validation or prediction claim.')
write_json(plan,file.path(O,'plan.json'),auto_unbox=TRUE,pretty=TRUE)
a<-read.delim(file.path(P,'associations.tsv'),check.names=FALSE);selected<-a[a$status=='FIT_OK',];stopifnot(nrow(selected)==3690)
c<-read.delim(file.path(P,'clinical_PRIVATE.tsv'),check.names=FALSE);s<-read.delim(gzfile(file.path(P,'scores_PRIVATE.tsv.gz')),check.names=FALSE);models<-fromJSON(file.path(P,'plan.json'))$models
out<-list();coeff<-list();counter<-0L
for(i in seq_len(nrow(selected))) {
 old<-selected[i,];g<-s[s$cancer==old$cancer & s$branch==old$branch & s$cm==old$cm,];z<-c[match(g$sample,c$sample),];stopifnot(all(z$sample==g$sample));z$score_sd<-g$score_sd;z$time<-as.numeric(z[[paste0(old$endpoint,'.time')]]);z$event<-as.numeric(z[[old$endpoint]])
 fields<-c('time','event','score_sd',models[[old$model]]);z<-z[complete.cases(z[,fields]) & z$time>0 & z$event %in% c(0,1),];stopifnot(nrow(z)==old$patients,sum(z$event)==old$events,!anyDuplicated(z$patient));cols<-strsplit(old$columns,'|',fixed=TRUE)[[1]];early<-sum(z$event[z$time<=365.25]);late<-sum(z$event[z$time>365.25]);beyond<-sum(z$time>365.25)
 row<-data.frame(id=old$id,cancer=old$cancer,branch=old$branch,cm=old$cm,endpoint=old$endpoint,model=old$model,patients=nrow(z),events=sum(z$event),early_events=early,late_events=late,patients_beyond_cut=beyond,columns=paste(c(cols,'score_late'),collapse='|'),status='NOT_RUN',warnings='',beta_early=NA_real_,se_early=NA_real_,HR_early=NA_real_,CI_early_low=NA_real_,CI_early_high=NA_real_,p_early=NA_real_,beta_late=NA_real_,se_late=NA_real_,HR_late=NA_real_,CI_late_low=NA_real_,CI_late_high=NA_real_,p_late=NA_real_,beta_change=NA_real_,se_change=NA_real_,p_change=NA_real_,loglik=NA_real_,cov_score_change=NA_real_,stringsAsFactors=FALSE)
 if(sum(z$event)<max(30,10*(length(cols)+1)) || min(early,late)<20 || beyond<20) {row$status<-'INSUFFICIENT_PERIOD_EVENTS';out[[i]]<-row;next}
 zz<-survSplit(Surv(time,event)~.,data=z,cut=365.25,start='tstart',end='time',event='event',episode='period');zz$score_late<-ifelse(zz$tstart>=365.25,zz$score_sd,0);stopifnot(sum(zz$event)==sum(z$event),all(zz$time>zz$tstart));design<-c(cols,'score_late')
 X<-cbind(1,as.matrix(zz[,design]));if(qr(X)$rank<ncol(X) || kappa(X)>1e8) {row$status<-'RANK_DEFICIENT_OR_ILL_CONDITIONED';out[[i]]<-row;next}
 warns<-character();failure<-NULL
 fit<-tryCatch(withCallingHandlers(coxph(as.formula(paste('Surv(tstart,time,event) ~',paste(design,collapse='+'))),data=zz,ties='efron',robust=FALSE,singular.ok=FALSE,control=coxph.control(iter.max=100,eps=1e-9)),warning=function(w){warns<<-c(warns,conditionMessage(w));invokeRestart('muffleWarning')}),error=function(e){failure<<-conditionMessage(e);NULL})
 row$warnings<-paste(c(warns,failure),collapse='; ')
 if(is.null(fit)||length(warns)>0) {row$status<-'FIT_ERROR_OR_WARNING';out[[i]]<-row;next}
 co<-coef(fit);V<-vcov(fit);se<-sqrt(diag(V));if(any(!is.finite(c(co,se,fit$loglik)))||any(se<=0)||fit$iter>=100) {row$status<-'NONFINITE_OR_NONCONVERGED';out[[i]]<-row;next}
 b<-co['score_sd'];delta<-co['score_late'];be<-b;bl<-b+delta;see<-se['score_sd'];sed<-se['score_late'];sel<-sqrt(V['score_sd','score_sd']+V['score_late','score_late']+2*V['score_sd','score_late']);stopifnot(sel>0)
 row$status<-'FIT_OK';row$beta_early<-be;row$se_early<-see;row$HR_early<-exp(be);row$CI_early_low<-exp(be-qnorm(.975)*see);row$CI_early_high<-exp(be+qnorm(.975)*see);row$p_early<-2*pnorm(-abs(be/see));row$beta_late<-bl;row$se_late<-sel;row$HR_late<-exp(bl);row$CI_late_low<-exp(bl-qnorm(.975)*sel);row$CI_late_high<-exp(bl+qnorm(.975)*sel);row$p_late<-2*pnorm(-abs(bl/sel));row$beta_change<-delta;row$se_change<-sed;row$p_change<-2*pnorm(-abs(delta/sed));row$loglik<-tail(fit$loglik,1);row$cov_score_change<-V['score_sd','score_late'];out[[i]]<-row
 coeff[[length(coeff)+1]]<-data.frame(id=old$id,term=names(co),beta=as.numeric(co),se=as.numeric(se))
 if(i%%100==0) {write_json(list(pid=Sys.getpid(),processed=i,total=nrow(selected)),file.path(O,'progress.json'),auto_unbox=TRUE);cat('MODELS',i,'\n');flush.console()}
}
t<-do.call(rbind,out);co<-do.call(rbind,coeff);ok<-t$status=='FIT_OK';pv<-c(a$p[is.finite(a$p)],t$p_early[ok],t$p_late[ok],t$p_change[ok]);q<-p.adjust(pv,'BH');nold<-sum(is.finite(a$p));nnew<-sum(ok);a$q_joint_piecewise<-NA_real_;a$q_joint_piecewise[is.finite(a$p)]<-q[seq_len(nold)]
for(j in 1:3) {name<-c('early','late','change')[j];t[[paste0('q_joint_',name)]]<-NA_real_;t[[paste0('q_joint_',name)]][ok]<-q[nold+(j-1)*nnew+seq_len(nnew)]}
write.table(t,file.path(O,'piecewise_associations.tsv'),sep='\t',row.names=FALSE,quote=FALSE,na='NA');write.table(co,file.path(O,'all_coefficients.tsv'),sep='\t',row.names=FALSE,quote=FALSE,na='NA');write.table(a,file.path(O,'prior_associations_joint_q.tsv'),sep='\t',row.names=FALSE,quote=FALSE,na='NA')
write_json(list(status='PIECEWISE_MODELS_WRITTEN_PENDING_INDEPENDENT_AUDIT',planned=nrow(t),fitted=sum(ok),status_counts=as.list(table(t$status)),joint_tests=length(pv),time_change_joint_q05=sum(t$q_joint_change<.05,na.rm=TRUE),limitations=plan$limitations),file.path(O,'complete.json'),auto_unbox=TRUE,pretty=TRUE)
cat('COMPLETE',sum(ok),'MODELS\n')
